# Database — defaults to SQLite for local dev
DATABASE_URL=sqlite:///./sales_analytics.db

# JWT secret — MUST override in production
SECRET_KEY=dev-secret-key-change-in-production

# Redis for rate limiting — "memory://" for local dev (in-memory, no Redis needed)
REDIS_URL=memory://

# CORS Allowed Origins
CORS_ORIGINS=["*"]

# Google Generative AI — powers /ai/insights (Gemini analyst report)
# Get a free key at https://aistudio.google.com/app/apikey
# Leave blank to disable AI insights (endpoint still returns 200 with raw data)
GOOGLE_API_KEY=
